---
import { anchors } from '../data/anchors';
// স্থাপত্য ও নকশা — বাংলাপিডিয়া, বাংলাদেশ ট্যুরিজম বোর্ডের প্রকাশ্য তথ্য অনুসারে সংকলিত।
const specs = [
  ['মূল কাঠামোর উচ্চতা', '~১৫০ ফুট (৪৫.৭ মিটার)'],
  ['প্রাঙ্গণের আয়তন', '~৩৪ হেক্টর (৮৪ একর); বাইরে আরও ~১০ হেক্টর সবুজ'],
  ['প্রধান উপকরণ', 'কংক্রিটের মূল কাঠামো; লাল ইটের আঙিনা ও পথ'],
  ['নকশা-প্রতিযোগিতা', '১৯৭৮; জমা পড়েছিল ৫৭টি প্রস্তাব'],
  ['নকশাকার', 'স্থপতি সৈয়দ মাইনুল হোসেন'],
  ['নির্মাণ-তত্ত্বাবধান', 'সরকারি গণপূর্ত বিভাগ'],
  ['উদ্বোধন', '১৬ ডিসেম্বর ১৯৮২ (বিজয় দিবস)']
];
const phases = [
  ['১৯৭২', 'স্বাধীনতার পর জমি অধিগ্রহণ ও প্রকল্প-সড়কের কাজ শুরু'],
  ['১৯৭৬–৭৮', 'স্থান চূড়ান্ত ও জাতীয় নকশা-প্রতিযোগিতা (৫৭ প্রস্তাব থেকে নির্বাচন)'],
  ['১৯৭৯–১৯৮২', 'মূল কাঠামো, কৃত্রিম হ্রদ, গণকবর-সম্মুখ প্রাঙ্গণ ও আঙিনার নির্মাণ'],
  ['১৯৮২', 'বিজয় দিবসে (১৬ ডিসেম্বর) জাতীয় স্মৃতিসৌধ উদ্বোধন']
];
---
<section id={anchors.architecture} class="container-shell py-18 sm:py-24">
  <div class="grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
    <div>
      <p class="section-kicker">স্থাপত্য ও নকশা</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">একটি অক্ষে সাজানো উত্থান—পাথরে লেখা সংগ্রামের ভাষা</h2>
      <div class="prose-bn mt-6 space-y-5 text-lg">
        <p>প্রধান ফটক দিয়ে ঢুকলে স্মৃতিসৌধ দেখা যায় প্রবেশ-অক্ষের ঠিক সামনে। তবে মূল বেদিতে পৌঁছাতে বেশ কয়েকটি উঁচু-নিচু এলাকা, পাকা পথ আর কৃত্রিম হ্রদের ওপর সেতু পেরোতে হয়—এই যাত্রাপথ স্থপতির পরিকল্পনায় স্বাধীনতা-সংগ্রামের দীর্ঘ পথের প্রতীক হয়ে থাকে।</p>
        <p>মূল কাঠামোটি সাত জোড়া ধাপে সাজানো অসম উচ্চতার ত্রিভুজাকার কংক্রিট-প্রাচীরের সমন্বয়ে গড়া; স্তম্ভগুলো একই অক্ষে ক্রমশ উঁচু হয়ে কেন্দ্রের শীর্ষে মিলিত হয়—উচ্চতা প্রায় ১৫০ ফুট। সবচেয়ে বাইরের জোড়া সবচেয়ে নিচু ও বিস্তৃত; ভেতরের দিকে অনুপাত বদলাতে বদলাতে চূড়ায় পৌঁছায়। বাংলাপিডিয়ার বর্ণনা অনুযায়ী ভিন্ন কোণ থেকে দেখলে কাঠামোটির রূপরেখা বদলে যায়—তাই হাঁটার প্রতিটি ধাপে ছবি বদলায়।</p>
        <p>চূড়ার দিকে ওঠা এই স্তরগুলো বাংলাদেশের স্বাধীনতা-সংগ্রামের সাতটি অধ্যায়কে স্মরণ করায়—১৯৫২-এর ভাষা আন্দোলন থেকে ১৯৭১-এর মুক্তিযুদ্ধ। প্রধান কাঠামো কংক্রিটে নির্মিত; চারপাশের আঙিনা, পথ ও বসার জায়গায় ব্যবহার করা হয়েছে লাল ইট, যা কংক্রিটের ধূসর গাম্ভীর্যের বিপরীতে উষ্ণতা আনে। সম্মুখ প্রাঙ্গণে গণকবর ও প্রতিফলন-পুকুর রয়েছে, আর সবুজ উদ্যানের মধ্যে দিয়ে সাজানো পথগুলো পুরো কমপ্লেক্সকে একটি শান্ত, শ্রদ্ধার স্থানে পরিণত করেছে।</p>
      </div>
    </div>
    <aside class="rounded-[2rem] border border-black/10 bg-white/70 p-7 shadow-xl shadow-black/5 sm:p-8">
      <p class="section-kicker">এক নজরে তথ্য</p>
      <dl class="mt-5 divide-y divide-black/10">
        {specs.map(([k, v]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[1fr_1.35fr] sm:gap-4">
            <dt class="text-sm font-bold text-[#7a2a26]">{k}</dt>
            <dd class="text-sm font-semibold leading-6 text-[#3f4943]">{v}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 rounded-xl bg-[#8a2e2a]/8 px-3 py-2 text-xs font-semibold leading-5 text-[#7a2a26]">উৎস: বাংলাপিডিয়া ও বাংলাদেশ ট্যুরিজম বোর্ডের প্রকাশ্য তথ্য। উচ্চতা-আয়তন আনুমানিক; সংশ্লিষ্ট সরকারি নথিতে যাচাই করা যায়।</p>
    </aside>
  </div>

  <div class="mt-14">
    <h3 class="text-2xl font-black">নির্মাণ-পর্ব এক নজরে</h3>
    <div class="mt-6 grid gap-3 md:grid-cols-4">
      {phases.map(([yr, txt], i) => (
        <div class="relative overflow-hidden rounded-2xl border border-black/10 bg-white/65 p-5 pt-11">
          <span class="absolute left-5 top-0 h-8 w-px bg-[#173d30]" style={`transform:rotate(${(i - 1.5) * 4}deg);transform-origin:top`}></span>
          <p class="text-xl font-black text-[#173d30]">{yr}</p>
          <p class="mt-2 text-sm font-semibold leading-6 text-[#3f4943]">{txt}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm leading-6 text-[#5d665f]">নির্মাণ-পর্বের বিবরণ বাংলাপিডিয়ার ‘জাতীয় স্মৃতিসৌধ’ নিবন্ধ থেকে সংকলিত।</p>
  </div>
</section>
