---
import { anchors } from '../data/anchors';
import { buildNowHtml, buildDaysHtml, buildAdviceHtml } from '../data/weather';
import {fetchWeather,type Forecast} from '../data/weather';
let serverData:Forecast|null=null;try{serverData=await fetchWeather();}catch{}

const seasons = [
 {label:'গরম ও রোদ',title:'আসল তাপ ও UV দেখুন',body:'পানীয় জল ও রোদ থেকে সুরক্ষা রাখুন; নিশ্চিত খোলা সময়ের মধ্যে ছোট রুট বেছে বিশ্রাম নিন।'},
 {label:'বৃষ্টি ও মেঘ',title:'পথ ও প্রবেশ আলাদা করে যাচাই',body:'মেঘ মানেই কম UV নয়। বৃষ্টি, পিচ্ছিল পথ বা স্থানীয় নিয়ন্ত্রণ থাকলে পরিকল্পনা বদলান।'},
 {label:'ঠান্ডা বা বাতাস',title:'উপযুক্ত পোশাক ও নমনীয় রুট',body:'প্রয়োজনমতো বাড়তি স্তরের পোশাক রাখুন। প্রবল বাতাস বা বজ্রের সময় খোলা জায়গায় থাকবেন না।'}
];

const initialNowHtml = serverData && serverData.current ? buildNowHtml(serverData) : '';
const initialDaysHtml = serverData && serverData.daily ? buildDaysHtml(serverData) : '';
const initialAdviceHtml = serverData && serverData.current ? buildAdviceHtml(serverData) : '';
---
<section id={anchors.weather} class="border-y border-black/10 bg-[#eef0ea] py-18 sm:py-24">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">আবহাওয়া ও পরিকল্পনা</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">এখনকার আবহাওয়া ও ৭ দিনের পূর্বাভাস</h2>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">স্মৃতিসৌধ এলাকার Open-Meteo আবহাওয়া-মডেল; এটি ঘটনাস্থলের সরাসরি পরিমাপ নয়। পোশাক ও বিরতির পরিকল্পনায় ব্যবহার করুন, তবে প্রবেশ বা আনুষ্ঠানিক বন্ধের খবর হিসেবে নয়।</p>
    </div>

    <div class="mt-9 grid gap-4 md:grid-cols-3">
      {seasons.map((s) => (
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black tracking-wide text-[#8a2e2a]">{s.label}</p>
          <h3 class="mt-2 text-lg font-black">{s.title}</h3>
          <p class="mt-2 text-sm leading-7 text-[#505a54]">{s.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,.95fr)_minmax(0,1.05fr)]">
      <div class="card rounded-[2rem] p-7">
        <p class="text-sm font-black text-[#8a2e2a]">এখনকার আবহাওয়া</p>
        <div id="wx-now" class="mt-3 rounded-2xl bg-[#f0ead9] p-6 text-sm leading-7 text-[#4d5751]">
          {initialNowHtml
            ? <div set:html={initialNowHtml} />
            : <p>আবহাওয়ার তথ্য এখন উপলব্ধ নয়; বর্তমান সরকারি পূর্বাভাস দেখুন।</p>}
        </div>
      </div>
      <div class="card rounded-[2rem] p-7">
        <p class="text-sm font-black text-[#8a2e2a]">আগামী ৭ দিন</p>
        <div id="wx-days" class="mt-3 rounded-2xl bg-[#f0ead9] p-4 text-sm leading-7 text-[#4d5751]">
          {initialDaysHtml
            ? <div set:html={initialDaysHtml} />
            : <p>আবহাওয়ার তথ্য এখন উপলব্ধ নয়; বর্তমান সরকারি পূর্বাভাস দেখুন।</p>}
        </div>
      </div>
    </div>
    <div class="card mt-5 rounded-[2rem] p-7">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-sm font-black text-[#8a2e2a]">ভিজিটর পরামর্শ</p>
          <p class="mt-1 max-w-2xl text-xs leading-6 text-[#5d665f]">আবহাওয়া অনুযায়ী শুধু প্রাসঙ্গিক পরামর্শই দেখানো হয়; প্রযোজ্য না হলে কোনো ব্লকই দেখানো হয় না। স্মৃতিসৌধ মূলত খোলা প্রাঙ্গণ, তাই রোদ, বৃষ্টি ও বাতাসের প্রভাব এখানে বেশি টের পাওয়া যায়।</p>
        </div>
        <span class="shrink-0 rounded-full bg-[#173d30]/10 px-3 py-1 text-xs font-bold text-[#31583f]">খোলা প্রাঙ্গণ · মাঠ ও প্রতিফলন-পুকুর</span>
      </div>
      <div id="wx-advice" class="mt-4 text-sm">
        {initialAdviceHtml
          ? <div set:html={initialAdviceHtml} />
          : <p class="text-sm leading-6 text-[#4d5751]">সাম্প্রতিক তথ্য ছাড়া পরামর্শ দেখানো যাচ্ছে না।</p>}
      </div>
    </div>
    <p id="wx-note" class="mt-4 text-xs leading-6 text-[#5d665f]">এটি আবহাওয়া-মডেলের পূর্বাভাস, সরকারি সতর্কতা বা প্রবেশের ঘোষণা নয়। {serverData ? `মডেলের সময়: ${serverData.current.time.replace("T"," ")} · Asia/Dhaka (UTC+6)।` : "সাম্প্রতিক তথ্য এখন পাওয়া যায়নি।"} বাস্তব পরিস্থিতি ও স্থানীয় নির্দেশনা দেখুন।</p>
  </div>
</section>

<noscript><p class="container-shell mt-3 text-sm">JavaScript বন্ধ থাকলে এই পাতার তৈরির সময়ের তথ্য নতুন হবে না; বর্তমান সরকারি পূর্বাভাস দেখুন।</p></noscript>
{serverData && <script type="application/json" id="wx-init" is:inline set:html={JSON.stringify(serverData).replace(/</g,'\\u003c')}></script>}

<script>import {initWeather} from '../data/weather-client';initWeather();</script>
<style>#wx-now,#wx-days,#wx-advice,#wx-now>* {min-width:0;overflow-wrap:anywhere;}</style>
