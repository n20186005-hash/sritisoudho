---
import { anchors } from '../data/anchors';
import { buildNowHtml, buildDaysHtml, buildAdviceHtml, WX_API_URL } from '../data/weather';
// সাভার/জাতীয় স্মৃতিসৌধ (২৩.৯১১৩°উ, ৯০.২৫২২°পূ) এর জন্য আবহাওয়া মডিউল।
// ডিজাইন নোট (শুধু কোডারদের জন্য, পৃষ্ঠার দর্শনার্থীদের কাছে দেখানো হয় না):
// 1) সার্ভার-সাইড: বিল্ড/রেন্ডার-সময় Open-Meteo থেকে বর্তমান + ৭ দিনের পূর্বাভাস
//    (UV/বৃষ্টি-সম্ভাবনা/সতর্কবার্তাসহ) নিয়ে স্ট্যাটিক HTML-এ SSR হিসেবে বসানো হয়।
// 2) ক্লায়েন্ট-সাইড: পেজ খোলার পর ৩০ মিনিটের স্থানীয় ক্যাশসহ সাম্প্রতিক ডেটা রিফ্রেশ হয়।
// 3) ভিজিটর-পরামর্শ ব্লকটি wxAdvice()/buildAdviceHtml() দিয়ে তৈরি — শুধু প্রাসঙ্গিক শর্তে
//    প্রাসঙ্গিক পরামর্শ রেন্ডার হয় (খোলা প্রাঙ্গণ-অভিযোজিত), কোনো কারিগরি শব্দ/API নাম নয়।
// 4) সাধারণ দর্শনার্থীকে API-এর নাম/মুক্ত/কী-বিহীন ইত্যাদি কারিগরি বিবরণ দেখানো হয় না।

// বিল্ড-টাইম সার্ভার ফেচ: সফল হলে নিচে প্রাথমিক পূর্বাভাস সহ স্ট্যাটিক HTML তৈরি হয়;
// নেটওয়ার্ক অনুপলব্ধ/টাইমআউট হলে বিল্ড কখনো ব্যর্থ হয় না — কেবল প্রাথমিক ডেটা খালি থাকে।
let serverData: Record<string, unknown> | null = null;
try {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 7000);
  try {
    const res = await fetch(WX_API_URL, { signal: controller.signal });
    if (res.ok) serverData = await res.json();
  } finally {
    clearTimeout(timer);
  }
} catch {
  serverData = null;
}

const seasons = [
  {
    label: 'নভেম্বর–ফেব্রুয়ারি · শীত',
    title: 'সবচেয়ে আরামদায়ক',
    body: 'শুষ্ক ও মৃদু ঠান্ডা আবহাওয়া; দিনে রোদ, সন্ধ্যায় হালকা শীতলতা। বাইরে ঘোরার ও ছবি তোলার জন্য সেরা সময়।'
  },
  {
    label: 'মার্চ–জুন · গ্রীষ্ম',
    title: 'গরম ও আর্দ্র',
    body: 'দিনের তাপ ও আর্দ্রতা বেশি থাকে; সকাল-সকাল বা শেষ বিকেলে যাওয়া ভালো। পানীয় জল ও মাথা-ঢাকার ব্যবস্থা রাখুন।'
  },
  {
    label: 'জুন–অক্টোবর · বর্ষা',
    title: 'বৃষ্টি ও সবুজ',
    body: 'মৌসুমি বৃষ্টিতে আঙিনা ভিজে থাকে; ছাতা/রেইনকোট রাখুন, ভেজা পথে সতর্ক হাঁটুন। মেঘলা আলোয় ছবিও সুন্দর হয়।'
  }
];

const initialNowHtml = serverData && (serverData as any).current ? buildNowHtml(serverData) : '';
const initialDaysHtml = serverData && (serverData as any).daily ? buildDaysHtml(serverData) : '';
const initialAdviceHtml = serverData && (serverData as any).current ? buildAdviceHtml(serverData) : '';
---
<section id={anchors.weather} class="border-y border-black/10 bg-[#eef0ea] py-18 sm:py-24">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">আবহাওয়া ও পরিকল্পনা</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">এখনকার আবহাওয়া ও ৭ দিনের পূর্বাভাস</h2>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">সাভার এলাকার (২৩.৯১°উ, ৯০.২৫°পূ) হালনাগাদ আবহাওয়া ও আগামী ৭ দিনের পূর্বাভাস এখানে দেখানো হয়েছে। স্মৃতিসৌধ মূলত খোলা প্রাঙ্গণ, তাই বৃষ্টি বা প্রচণ্ড গরমের দিনে পরিকল্পনা বদলে নেওয়া ভালো।</p>
    </div>

    <div class="mt-9 grid gap-4 md:grid-cols-3">
      {seasons.map((s) => (
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black tracking-wide text-[#8a2e2a]">{s.label}</p>
          <h3 class="mt-2 text-lg font-black">{s.title}</h3>
          <p class="mt-2 text-sm leading-7 text-[#505a54]">{s.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-[.95fr_1.05fr]">
      <div class="card rounded-[2rem] p-7">
        <p class="text-sm font-black text-[#8a2e2a]">এখনকার আবহাওয়া</p>
        <div id="wx-now" class="mt-3 rounded-2xl bg-[#f0ead9] p-6 text-sm leading-7 text-[#4d5751]">
          {initialNowHtml
            ? <div set:html={initialNowHtml} />
            : <p>আবহাওয়ার তথ্য লোড হচ্ছে…</p>}
        </div>
      </div>
      <div class="card rounded-[2rem] p-7">
        <p class="text-sm font-black text-[#8a2e2a]">আগামী ৭ দিন</p>
        <div id="wx-days" class="mt-3 rounded-2xl bg-[#f0ead9] p-4 text-sm leading-7 text-[#4d5751]">
          {initialDaysHtml
            ? <div set:html={initialDaysHtml} />
            : <p>আবহাওয়ার তথ্য লোড হচ্ছে…</p>}
        </div>
      </div>
    </div>
    <div class="card mt-5 rounded-[2rem] p-7">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-sm font-black text-[#8a2e2a]">ভিজিটর পরামর্শ</p>
          <p class="mt-1 max-w-2xl text-xs leading-6 text-[#5d665f]">আবহাওয়া অনুযায়ী শুধু প্রাসঙ্গিক পরামর্শই দেখানো হয়; প্রযোজ্য না হলে কোনো ব্লকই দেখানো হয় না। স্মৃতিসৌধ মূলত খোলা প্রাঙ্গণ, তাই রোদ, বৃষ্টি ও বাতাসের প্রভাব এখানে বেশি টের পাওয়া যায়।</p>
        </div>
        <span class="shrink-0 rounded-full bg-[#173d30]/10 px-3 py-1 text-xs font-bold text-[#31583f]">খোলা প্রাঙ্গণ · মাঠ ও প্রতিফলন-পুকুর</span>
      </div>
      <div id="wx-advice" class="mt-4 text-sm">
        {initialAdviceHtml
          ? <div set:html={initialAdviceHtml} />
          : <p class="text-sm leading-6 text-[#4d5751]">আবহাওয়া-ভিত্তিক পরামর্শ লোড হচ্ছে…</p>}
      </div>
    </div>
    <p class="mt-4 text-xs leading-6 text-[#5d665f]">এটি আবহাওয়া-মডেলের পূর্বাভাস-প্রাক্কলন ও তার ভিত্তিতে তৈরি স্বয়ংক্রিয় পরামর্শ; বাস্তব অবস্থা ভিন্ন হতে পারে। বৃষ্টি বা ঝড়ের সম্ভাবনায় ভ্রমণের আগের দিন ও সকালে সর্বশেষ পূর্বাভাস দেখে নেওয়া ভালো।</p>
  </div>
</section>

{serverData && <script type="application/json" id="wx-init" is:inline set:html={JSON.stringify(serverData)}></script>}

<script>
  import { buildNowHtml, buildDaysHtml, buildAdviceHtml, WX_API_URL } from '../data/weather';
  const KEY = 'nmm_weather_v3';
  const TTL = 30 * 60 * 1000; // ৩০ মিনিট ক্যাশ

  function rootNow(): HTMLElement | null {
    return document.getElementById('wx-now');
  }
  function rootDays(): HTMLElement | null {
    return document.getElementById('wx-days');
  }
  function rootAdvice(): HTMLElement | null {
    return document.getElementById('wx-advice');
  }

  function render(d: any): void {
    const now = buildNowHtml(d);
    const days = buildDaysHtml(d);
    const advice = buildAdviceHtml(d);
    const rn = rootNow();
    const rd = rootDays();
    const ra = rootAdvice();
    if (rn && now) rn.innerHTML = now;
    if (rd && days) rd.innerHTML = days;
    if (ra) ra.innerHTML = advice || '<p class="text-sm leading-6 text-[#4d5751]">আবহাওয়া-ভিত্তিক পরামর্শ পাওয়া যায়নি।</p>';
  }

  function renderError(): void {
    const rn = rootNow();
    if (rn) rn.innerHTML = '<p>আবহাওয়ার তথ্য এই মুহূর্তে লোড করা যায়নি। একটু পরে আবার চেষ্টা করুন।</p>';
    const rd = rootDays();
    if (rd) rd.innerHTML = '<p>আবহাওয়ার তথ্য এই মুহূর্তে লোড করা যায়নি। একটু পরে আবার চেষ্টা করুন।</p>';
    const ra = rootAdvice();
    if (ra) ra.innerHTML = '<p class="text-sm leading-6 text-[#4d5751]">আবহাওয়া-ভিত্তিক পরামর্শ এই মুহূর্তে তৈরি করা যায়নি। একটু পরে আবার চেষ্টা করুন।</p>';
  }

  // বিল্ড-সময়ের প্রাথমিক ডেটা: সাথে সাথে দেখান + স্থানীয় ক্যাশে বসান
  const seedEl = document.getElementById('wx-init');
  let seed: any = null;
  if (seedEl) {
    try { seed = JSON.parse(seedEl.textContent || ''); } catch (e) { seed = null; }
  }
  if (seed && seed.current) {
    render(seed);
    try {
      if (!localStorage.getItem(KEY)) {
        localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), data: seed }));
      }
    } catch (e) { /* স্টোরেজ না থাকলে কিছু যায় আসে না */ }
  }

  async function loadWeather(): Promise<void> {
    const now = Date.now();
    let data: any = null;
    try {
      const cached = localStorage.getItem(KEY);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (parsed && parsed.t && now - parsed.t < TTL && parsed.data) data = parsed.data;
      }
    } catch (e) { /* ignore */ }

    if (!data) {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 15000);
      try {
        const res = await fetch(WX_API_URL, { signal: controller.signal });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        data = await res.json();
        try { localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), data })); } catch (e) { /* ignore */ }
      } catch (e) {
        renderError();
        return;
      } finally {
        window.clearTimeout(timer);
      }
    }
    render(data);
  }

  loadWeather();
</script>
