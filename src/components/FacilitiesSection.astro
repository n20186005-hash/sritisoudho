---
import { anchors } from '../data/anchors';
// স্মৃতিসৌধ এলাকার দর্শনার্থী-সুবিধা (ধরনভিত্তিক, নিরপেক্ষ — কোনো প্রতিষ্ঠানের সুপারিশ নয়)।
const items = [
  {
    "title": "শৌচাগার",
    "desc": "যাত্রার আগে আপনার দলের উপযোগী শৌচাগার কোথায় ও কখন ব্যবহার করা যায় জেনে নিন; এই গাইড বর্তমান সুবিধার সংখ্যা বা প্রবেশযোগ্যতা নিশ্চিত করে না।"
  },
  {
    "title": "অনুমোদিত পার্কিং",
    "desc": "গাড়ি কোথায় নামাবে ও তুলবে, অনুমোদিত স্থান এবং বর্তমান ফি ব্যবস্থাপনার নির্দেশনায় নিশ্চিত করুন। স্থান পাওয়া নিশ্চিত নয়।"
  },
  {
    "title": "পানীয় জল ও খাবার",
    "desc": "নিজের পানীয় জল ও প্রয়োজনীয় খাবার রাখুন; নির্মাণ-ইতিহাসের ক্যাফেটেরিয়া মানে আজ চালু দোকান নয়।"
  },
  {
    "title": "আলাদা আবাসন",
    "desc": "রাত্রিযাপন দরকার হলে আলাদা প্রতিষ্ঠানের বুকিং, পরিচয়, নিয়ম ও পরিবহন নিজে যাচাই করুন; গাইড কোনো আবাসন তালিকা অনুমোদন করছে না।"
  },
  {
    "title": "প্রয়োজনীয় জিনিস",
    "desc": "ওষুধ, ছাতা বা সুরক্ষাসামগ্রী আগে গুছিয়ে নিন; প্রাঙ্গণ বা আশেপাশে নির্দিষ্ট পণ্য পাওয়া যাবে ধরে নেবেন না।"
  },
  {
    "title": "জ্বালানি ও চার্জিং",
    "desc": "নিজের সম্পূর্ণ রুটে জ্বালানি বা বৈদ্যুতিক চার্জিংয়ের নির্ভরযোগ্য ব্যবস্থা আগে ঠিক করুন; এখানে বর্তমান স্টেশন তালিকা নেই।"
  },
  {
    "title": "চিকিৎসা ও ওষুধ",
    "desc": "নিয়মিত ওষুধ সঙ্গে রাখুন এবং প্রয়োজন হলে নিকটতম উপযুক্ত চিকিৎসাসেবার বর্তমান যোগাযোগ আগে যাচাই করুন। কোনো ক্লিনিক সাইটে আছে বলা হচ্ছে না।"
  },
  {
    "title": "পেমেন্ট",
    "desc": "বর্তমান টিকিট বা ফি এবং গ্রহণযোগ্য পেমেন্ট পদ্ধতি সরাসরি নিশ্চিত করুন; ATM বা ডিজিটাল পেমেন্টের উপস্থিতি নিশ্চিত নয়।"
  },
  {
    "title": "যোগাযোগ ও প্রবেশযোগ্যতা",
    "desc": "মানচিত্র ও জরুরি যোগাযোগ আগে সংরক্ষণ করুন। দলের চলাচলের চাহিদা অনুযায়ী সিঁড়ি, ঢাল, দূরত্ব ও সহায়তার ব্যবস্থা নিশ্চিত করুন।"
  }
];
const nums = ['১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
---
<section id={anchors.facilities} class="border-y border-black/10 bg-[#eef0ea] py-18 sm:py-24">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">পরিকল্পনার জন্য সুবিধা</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">শৌচাগার থেকে জ্বালানি—যা আগে জেনে রাখা ভালো</h2>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">এটি যাত্রার আগে নিশ্চিত করার তালিকা; যাচাইকৃত চালু সেবার তালিকা বা কোনো প্রতিষ্ঠানের সুপারিশ নয়। আপনার প্রয়োজন অনুযায়ী ব্যবস্থাপনার কাছে জেনে নিন।</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {items.map((it, i) => (
        <article class="card flex flex-col rounded-3xl p-6">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#8a2e2a] text-sm font-black text-white">{nums[i]}</span>
            <h3 class="text-lg font-black">{it.title}</h3>
          </div>
          <p class="mt-4 flex-1 text-[15px] leading-7 text-[#505a54]">{it.desc}</p>
          <p class="mt-4 rounded-xl bg-[#173d30]/8 px-3 py-2 text-xs font-bold leading-5 text-[#31583f]">টিপ: সুবিধা-সংক্রান্ত নির্দিষ্ট খোলা সময়/ফি প্রকাশ্য উৎসে যাচাই করে নিন।</p>
        </article>
      ))}
    </div>
  </div>
</section>
