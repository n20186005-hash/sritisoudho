---
import { anchors } from '../data/anchors';
// স্মৃতিসৌধ এলাকার দর্শনার্থী-সুবিধা (ধরনভিত্তিক, নিরপেক্ষ — কোনো প্রতিষ্ঠানের সুপারিশ নয়)।
const items = [
  {
    title: 'শৌচাগার ও পরিচ্ছন্নতা',
    desc: 'স্মৃতিসৌধ প্রাঙ্গণ মূলত খোলা জনস্থান; অভ্যন্তরে দর্শনার্থী-শৌচাগার সংক্রান্ত নির্দিষ্ট সরকারি বিবরণ প্রকাশিত থাকে না। ব্যবস্থাপনা এলাকা, নিকটবর্তী বাসস্ট্যান্ড, বাজার বা খাবারের দোকান/রেস্তোরাঁয় ব্যবস্থা খোঁজা যেতে পারে। ভিড়ের দিনে সারি হতে পারে, তাই নিজের পরিকল্পনা আগে মিলিয়ে নিন।'
  },
  {
    title: 'পার্কিং',
    desc: 'ঢাকা–আরিচা মহাসড়কসংলগ্ন প্রধান ফটকের কাছে ব্যবস্থাপনার নির্ধারিত পার্কিং-এর ব্যবস্থা থাকে। ধারণক্ষমতা বা ফি সম্পর্কে নির্ভরযোগ্য প্রকাশ্য সরকারি তথ্য পাওয়া যায় না। জাতীয় দিবস, রাষ্ট্রীয় অনুষ্ঠান বা নিরাপত্তাজনিত কারণে পার্কিং সীমিত ও নিয়ন্ত্রিত হতে পারে; রিটার্নের সময় চালকের সঙ্গে মিলনের স্থান আগে ঠিক করে রাখুন।'
  },
  {
    title: 'খাবার ও পানীয়',
    desc: 'প্রাঙ্গণের নির্মাণ-ইতিহাসে ক্যান্টিন/খাবারের ব্যবস্থার উল্লেখ মেলে; নবীনগর বাসস্ট্যান্ড ও মহাসড়কসংলগ্ন এলাকায় ভাত, ডাল, ভর্তা, মাছ-মাংস, চা ও হালকা নাশতার ছোট দোকান রয়েছে। বড় ভিড়ে বসার জায়গা সীমিত হতে পারে; নিজের পানীয় জল সঙ্গে রাখা নিরাপদ।'
  },
  {
    title: 'থাকা-ওঠা / আবাসন',
    desc: 'স্মৃতিসৌধ প্রাঙ্গণের ভেতরে রাত্রিযাপনের ব্যবস্থা নেই। দিনের সফরে ঢাকা থেকে এসে ফেরা সাধারণত সম্ভব; প্রয়োজনে সাভার বাজার এলাকা ও ঢাকা শহরে হোটেল, মোটেল, গেস্টহাউস বা আবাসিক ব্যবস্থা রয়েছে। থাকার জায়গা বাছাইয়ের আগে বুকিং, দূরত্ব ও পরিবহন মিলিয়ে নেওয়া ভালো।'
  },
  {
    title: 'দোকান ও বাজার',
    desc: 'প্রতিদিনের প্রয়োজনীয় জিনিস (পানীয় জল, ছাতা, সানস্ক্রিন, নাশতা) নবীনগর বাসস্ট্যান্ড, সাভার বাজার ও মহাসড়কসংলগ্ন দোকানে পাওয়ার সম্ভাবনা বেশি। সুপারশপ/মার্কেটের অবস্থান ও খোলার সময় এলাকাভেদে বদলায়; দূরত্ব ও সময় আগে যাচাই করে নিন।'
  },
  {
    title: 'জ্বালানি ও যানবাহন-চার্জিং',
    desc: 'ব্যক্তিগত গাড়ি/সিএনজিতে এলে ঢাকা–আরিচা মহাসড়কে জ্বালানি (পেট্রল, ডিজেল, সিএনজি) নেওয়ার স্টেশন পাওয়া যায়। বৈদ্যুতিক যানবাহনের চার্জিং পয়েন্ট সীমিত ও পরিবর্তনশীল—সফরের আগে নিজের রুটে চার্জিং-এর ব্যবস্থা নিশ্চিত করুন। রাতে ফেরার পথে জ্বালানি যথেষ্ট রাখুন।'
  },
  {
    title: 'চিকিৎসা সেবা ও ফার্মেসি',
    desc: 'সাভার বাজার, নবীনগর বাসস্ট্যান্ড ও মহাসড়কসংলগ্ন এলাকায় ওষুধের দোকান, কমিউনিটি ক্লিনিক বা স্বাস্থ্যকেন্দ্র পাওয়ার সম্ভাবনা বেশি। প্রয়োজনীয় ওষুধ নিজের সঙ্গে রাখুন; বড় জরুরি অবস্থায় ঢাকার হাসপাতালগুলো তুলনামূলক কাছেই। নির্দিষ্ট কোনো প্রতিষ্ঠানের সুপারিশ এখানে নেই।'
  },
  {
    title: 'নগদ টাকা ও এটিএম',
    desc: 'প্রাঙ্গণ মূলত খোলা জনস্থান; ভেতরে এটিএম/ব্যাংক শাখার নির্ভরযোগ্য প্রকাশ্য তথ্য নেই। নবীনগর, সাভার বাজার ও মহাসড়কের ধারে ব্যাংক বুথ/এটিএম বা মোবাইল আর্থিক সেবার এজেন্ট থাকার সম্ভাবনা বেশি। পর্যাপ্ত নগদ ও মোবাইল ব্যালেন্স সঙ্গে রাখা নিরাপদ—সব জায়গায় ডিজিটাল পেমেন্ট কার্যকর নাও হতে পারে।'
  },
  {
    title: 'যোগাযোগ ও ইন্টারনেট',
    desc: 'সাভার ও নবীনগরে মোবাইল নেটওয়ার্ক ও ইন্টারনেট সাধারণত পাওয়া যায়; তবে জাতীয় অনুষ্ঠান বা বড় ভিড়ে সংযোগ ধীর হতে পারে। মানচিত্র, রুট ও পরিবারের সঙ্গে যোগাযোগের জন্য প্রাসঙ্গিক তথ্য আগে নামিয়ে (অফলাইন) রাখা এবং চার্জার/পাওয়ার-ব্যাংক সঙ্গে নেওয়া ভালো।'
  }
];
const nums = ['১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
---
<section id={anchors.facilities} class="border-y border-black/10 bg-[#eef0ea] py-18 sm:py-24">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">পরিকল্পনার জন্য সুবিধা</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">শৌচাগার থেকে জ্বালানি—যা আগে জেনে রাখা ভালো</h2>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">নিচের তালিকা কোনো প্রতিষ্ঠানের সুপারিশ নয়; স্মৃতিসৌধ এলাকা ঘিরে দর্শনার্থীর জন্য ধরনভিত্তিক সাধারণ নির্দেশনা মাত্র। স্থান, সময় ও ব্যবস্থাপনার ওপর সুবিধা বদলাতে পারে—গুরুত্বপূর্ণ প্রয়োজনে পরিচালনা কর্তৃপক্ষ বা সাভার উপজেলা প্রশাসনের কাছে যাচাই করুন।</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {items.map((it, i) => (
        <article class="card flex flex-col rounded-3xl p-6">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#8a2e2a] text-sm font-black text-white">{nums[i]}</span>
            <h3 class="text-lg font-black">{it.title}</h3>
          </div>
          <p class="mt-4 flex-1 text-[15px] leading-7 text-[#505a54]">{it.desc}</p>
          <p class="mt-4 rounded-xl bg-[#173d30]/8 px-3 py-2 text-xs font-bold leading-5 text-[#31583f]">টিপ: সুবিধা-সংক্রান্ত নির্দিষ্ট খোলা সময়/ফি প্রকাশ্য উৎসে যাচাই করে নিন।</p>
        </article>
      ))}
    </div>
  </div>
</section>
