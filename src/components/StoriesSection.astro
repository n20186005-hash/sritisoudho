---
import { anchors } from '../data/anchors';
// ইতিহাস-ভিত্তিক উপাখ্যান: প্রতিটি কার্ড প্রকাশ্য/যাচাইযোগ্য সূত্রের সরল ব্যাখ্যা (কিংবদন্তি নয়)।
const stories = [
  {
    tag: 'নকশা-প্রতিযোগিতা',
    title: '৫৭টি প্রস্তাবের মধ্যে একটি জয়ী নকশা',
    body: '১৯৭৮ সালে সরকারি গণপূর্ত বিভাগ জাতীয় স্মৃতিসৌধের নকশার জন্য দেশব্যাপী প্রতিযোগিতার আয়োজন করে। জমা পড়া ৫৭টি প্রস্তাবের মধ্য থেকে স্থপতি সৈয়দ মাইনুল হোসেনের নকশা নির্বাচিত হয়। সেটিই পরে কনকর্ড গ্রুপের নির্মাণে ও গণপূর্ত বিভাগের তত্ত্বাবধানে বাস্তবে রূপ নেয়।'
  },
  {
    tag: 'স্থাপত্য-রহস্য',
    title: 'কোণ বদলালেই বদলে যায় রূপ',
    body: 'বাংলাপিডিয়া লক্ষ করেছে, সাতটি অসম উচ্চতার ত্রিভুজাকার প্রাচীর নিজ নিজ বেদিতে সাজানো; সবচেয়ে উঁচু স্তম্ভটি দাঁড়িয়ে আছে সবচেয়ে খাটো বেদির ওপর। দর্শনার্থী ঘুরে ঘুরে দেখলে কাঠামোর সিলুয়েট প্রতিবার নতুন মনে হয়—এই ‘ভিন্ন কোণ, ভিন্ন রূপ’-এর অভিজ্ঞতাই স্থাপত্যটিকে ছবি তোলার অন্যতম প্রিয় বিষয় করে তুলেছে।'
  },
  {
    tag: 'জল ও আলো',
    title: 'হ্রদের জলে ভাসমান স্মৃতি',
    body: 'কৃত্রিম হ্রদ ও প্রতিফলন-পুকুর ছিল সাইট-পরিকল্পনারই অংশ; ১৯৮২ সালে মূল কাঠামোর সঙ্গে এগুলোও সম্পন্ন হয়। সকালের নরম আলো কিংবা শেষ বিকেলের সোনালি রোদে পুকুরের জলে স্মৃতিসৌধের প্রতিফলন—সবচেয়ে পরিচিত, সবচেয়ে বেশি ছড়িয়ে পড়া ছবিটির জন্ম এখানেই।'
  },
  {
    tag: 'জাতীয় ঐতিহ্য',
    title: 'বিজয় দিবসে জন্ম, শ্রদ্ধার কেন্দ্রে পরিণতি',
    body: '১৯৮২ সালের ১৬ ডিসেম্বর—বিজয় দিবসের দিনেই স্মৃতিসৌধ উদ্বোধন করা হয়। এরপর থেকে ২৬ মার্চ স্বাধীনতা দিবস ও ১৬ ডিসেম্বর বিজয় দিবসে রাষ্ট্রপ্রধানসহ সর্বস্তরের মানুষ এখানে শহীদদের প্রতি ফুল দিয়ে নীরব শ্রদ্ধা জানান। এই আনুষ্ঠানিক দিনগুলোতে ভিড় ও নিরাপত্তা-নিয়ন্ত্রণ বাড়ে, তাই নীরব পরিবেশে দেখতে চাইলে অন্য দিন বেছে নেওয়া সহজ।'
  }
];
---
<section id={anchors.stories} class="border-y border-black/10 bg-[#e7dfd2] py-18 sm:py-24">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">ইতিহাসের পাতা থেকে</p>
      <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">পাথরের পেছনে মানুষ, প্রতিযোগিতা আর আলো-জলের গল্প</h2>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">একটি জাতীয় স্মৃতিসৌধ মানে শুধু নির্মাণ নয়—তার পেছনে থাকে প্রতিযোগিতা, স্থপতির কল্পনা আর দর্শনার্থীদের স্মৃতি। নিচের গল্পগুলো বাংলাপিডিয়া ও বাংলাদেশ ট্যুরিজম বোর্ডের প্রকাশ্য তথ্যের সরল ব্যাখ্যা।</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {stories.map((s) => (
        <article class="card flex flex-col rounded-[2rem] p-7">
          <span class="self-start rounded-full bg-[#173d30]/10 px-3 py-1 text-xs font-black tracking-wide text-[#173d30]">{s.tag}</span>
          <h3 class="mt-4 text-2xl font-black leading-snug">{s.title}</h3>
          <p class="mt-4 leading-7 text-[#505a54]">{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
