---
// 内容块渲染器：所有主题页共用同一套区块样式，避免逐页手写 HTML。
import type { Block, Lang } from '../data/pages/types';
import { ATTRACTION } from '../data/site';

interface Props {
  blocks: Block[];
  lang: Lang;
}

const { blocks, lang } = Astro.props;
const isEn = lang === 'en';
---
{
  blocks.map((block, index) => {
    if (block.type === 'p') {
      return <p class="mt-5 text-lg leading-8 text-[#3f4943]">{block.text}</p>;
    }
    if (block.type === 'h2') {
      return (
        <h2 id={`sec-${index}`} class="mt-12 scroll-mt-28 text-3xl font-black leading-snug sm:text-4xl">
          {block.text}
        </h2>
      );
    }
    if (block.type === 'h3') {
      return <h3 class="mt-8 text-xl font-black leading-snug">{block.text}</h3>;
    }
    if (block.type === 'ul') {
      return (
        <ul class="mt-5 space-y-3">
          {block.items.map(item => (
            <li class="flex gap-3 text-lg leading-8 text-[#3f4943]">
              <span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[#8a2e2a]" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      );
    }
    if (block.type === 'ol') {
      return (
        <ol class="mt-5 space-y-3">
          {block.items.map((item, i) => (
            <li class="flex gap-3 text-lg leading-8 text-[#3f4943]">
              <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#8a2e2a] text-sm font-black text-white">
                {(i + 1).toLocaleString(isEn ? 'en-US' : 'bn-BD')}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      );
    }
    if (block.type === 'table') {
      return (
        <div class="mt-6 overflow-x-auto rounded-2xl border border-black/10 bg-white/70">
          <table class="w-full border-collapse text-left text-[15px] sm:text-base">
            <thead>
              <tr class="bg-[#eee8dc]">
                {block.head.map(cell => (
                  <th scope="col" class="border-b border-black/10 px-4 py-3 font-black">{cell}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {block.rows.map(row => (
                <tr class="even:bg-white/50">
                  {row.map(cell => (
                    <td class="border-b border-black/5 px-4 py-3 align-top leading-7 text-[#3f4943]">{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    }
    if (block.type === 'callout') {
      const warn = block.tone === 'warn';
      return (
        <aside class={`mt-6 rounded-2xl border px-5 py-4 ${warn ? 'border-[#8a2e2a]/35 bg-[#8a2e2a]/[.07]' : 'border-black/12 bg-[#eee8dc]/70'}`}>
          <p class={`text-xs font-black tracking-wide ${warn ? 'text-[#8a2e2a]' : 'text-[#173d30]'}`}>
            {block.title || (warn ? (isEn ? 'Please note' : 'লক্ষণীয়') : (isEn ? 'Note' : 'দ্রষ্টব্য'))}
          </p>
          <p class="mt-2 leading-8 text-[#3f4943]">{block.text}</p>
        </aside>
      );
    }
    if (block.type === 'steps') {
      return (
        <div class="mt-6 space-y-5">
          {block.items.map((item, i) => (
            <div class="flex gap-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#8a2e2a] font-black text-white">
                {(i + 1).toLocaleString(isEn ? 'en-US' : 'bn-BD')}
              </span>
              <div>
                <h3 class="font-black">{item.title}</h3>
                <p class="mt-1 leading-7 text-[#505a54]">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      );
    }
    if (block.type === 'links') {
      return (
        <div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
          {block.items.map(link => (
            <a
              class="rounded-full border border-black/15 px-4 py-2 no-underline hover:border-[#8a2e2a] hover:text-[#8a2e2a]"
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      );
    }
    if (block.type === 'map') {
      return (
        <div class="mt-6 overflow-hidden rounded-[2rem] border border-black/10 bg-white p-2 shadow-xl shadow-black/5">
          <iframe
            src={ATTRACTION.mapsEmbedUrl}
            class="h-[420px] w-full rounded-[1.55rem] border-0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title={isEn ? 'Map of the National Martyrs’ Monument' : 'জাতীয় স্মৃতিসৌধের মানচিত্র'}
          />
          <div class="flex flex-wrap items-center justify-between gap-3 p-4 text-sm">
            <span class="text-black/60">{isEn ? ATTRACTION.addressRegionFullEn : ATTRACTION.addressRegionFull} · {ATTRACTION.plusCode}</span>
            <a href={ATTRACTION.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#8a2e2a]">
              {isEn ? 'Open the full map →' : 'বড় মানচিত্র খুলুন →'}
            </a>
          </div>
        </div>
      );
    }
    return null;
  })
}
