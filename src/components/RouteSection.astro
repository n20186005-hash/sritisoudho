---
// ভেতরে কীভাবে ঘুরবেন — একটি সাধারণ দর্শন-রুটের রূপরেখা।
// এটি আনুষ্ঠানিক প্রাঙ্গণ-গাইড নয়; দর্শনার্থীর সুবিধার জন্য সাধারণ অভিজ্ঞতা-ভিত্তিক ধাপ।
const steps = [
  {
    "title": "প্রবেশের আগে",
    "body": "সেদিনের খোলা প্রবেশপথ ও অনুমতিপ্রাপ্ত অংশ জেনে নিন। ইতিহাসে বর্ণিত অক্ষ ও পথ সব সময় খোলা বা বাধামুক্ত থাকার নিশ্চয়তা নয়।"
  },
  {
    "title": "জলাশয় ও সেতুর বিন্যাস",
    "body": "বাংলাপিডিয়া জলাশয়, সেতু ও উঁচু-নিচু পথের নকশা বর্ণনা করে। খোলা অংশে নিরাপদ দূরত্ব থেকে দেখুন; জলাশয়ে নামবেন না।"
  },
  {
    "title": "শ্রদ্ধার স্থান",
    "body": "আনুষ্ঠানিক পথ, সমাধিক্ষেত্র ও শ্রদ্ধা নিবেদনের অংশের মর্যাদা বজায় রাখুন। কর্তৃপক্ষের বর্তমান নির্দেশনা অনুসরণ করুন।"
  },
  {
    "title": "দূর থেকে প্রাচীরের অনুপাত",
    "body": "অনুমতিপ্রাপ্ত স্থান থেকে ভিন্ন কোণে প্রাচীরগুলোর অনুপাত দেখুন। কাঠামোয় উঠবেন না বা নিষিদ্ধ পথ ধরবেন না।"
  },
  {
    "title": "ছোট রুট ও বিরতি",
    "body": "দলের গতি, চলাচলের প্রয়োজন ও আসল আবহাওয়া অনুযায়ী রুট ছোট করুন। বিশ্রাম বা সহায়তার বর্তমান ব্যবস্থা আগে নিশ্চিত করুন।"
  },
  {
    "title": "ফেরার ব্যবস্থা",
    "body": "অনুমোদিত মিলনস্থল ও ফেরার যান চালক বা অপারেটরের সঙ্গে ঠিক করুন। নির্দিষ্ট সময়ে গাড়ি বা বাস পাওয়া যাবে ধরে নেবেন না।"
  }
];
---
<section class="container-shell py-18 sm:py-24">
  <div class="max-w-3xl">
    <p class="section-kicker">ভেতরে কীভাবে ঘুরবেন</p>
    <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">অনুমতিপ্রাপ্ত অংশে নমনীয় দর্শন-পরিকল্পনা</h2>
    <p class="mt-5 text-lg leading-8 text-[#505a54]">দেড়–দুই ঘণ্টা একটি প্রাথমিক পরিকল্পনা হতে পারে; সব অংশ দেখা নিশ্চিত নয়। বর্তমান খোলা অংশ, নিরাপত্তা নিয়ন্ত্রণ, বিশ্রাম ও দলের চলাচলের চাহিদা অনুযায়ী নিচের ভাবনাগুলো বেছে নিন; এটি আনুষ্ঠানিক রুট নয়।</p>
  </div>
  <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {steps.map((s, i) => (
      <li class="card flex flex-col rounded-3xl p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#173d30] text-base font-black text-white">
            {['১', '২', '৩', '৪', '৫', '৬'][i]}
          </span>
          <h3 class="text-lg font-black leading-snug">{s.title}</h3>
        </div>
        <p class="mt-4 flex-1 text-[15px] leading-7 text-[#505a54]">{s.body}</p>
      </li>
    ))}
  </ol>
</section>
