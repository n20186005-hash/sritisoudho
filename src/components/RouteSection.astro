---
// ভেতরে কীভাবে ঘুরবেন — একটি সাধারণ দর্শন-রুটের রূপরেখা।
// এটি আনুষ্ঠানিক প্রাঙ্গণ-গাইড নয়; দর্শনার্থীর সুবিধার জন্য সাধারণ অভিজ্ঞতা-ভিত্তিক ধাপ।
const steps = [
  {
    title: 'প্রবেশ ও মূল অক্ষ',
    body: 'প্রধান ফটক দিয়ে ঢুকে সোজা সামনের দিকে হাঁটা শুরু করুন। দুই পাশে সবুজ লন আর খোলা আকাশ—প্রথম কয়েক মিনিট ধীরে চললেই স্মৃতিসৌধের রূপরেখা ধীরে ধীরে সামনে উঠে আসে।'
  },
  {
    title: 'হ্রদ ও সেতু',
    body: 'কৃত্রিম জলাশয় পাশে রেখে পাকা পথ ও সেতু পেরিয়ে মূল প্রাঙ্গণে ওঠা যায়। এ অংশ থেকেই প্রতিফলন-পুকুরের বিখ্যাত দৃশ্যটি সবচেয়ে ভালো চোখে পড়ে—ছবির জন্য থামার জনপ্রিয় জায়গা।'
  },
  {
    title: 'সম্মুখ প্রাঙ্গণ',
    body: 'মূল কাঠামোর সামনের প্রশস্ত প্রাঙ্গণ ও প্রতিফলন-পুকুরের ধার। এটি শ্রদ্ধা-অঞ্চল; ফুল দেওয়ার বা আনুষ্ঠানিক জায়গার প্রতি নীরবতা ও মর্যাদা বজায় রাখুন।'
  },
  {
    title: 'সাত জোড়া প্রাচীর',
    body: 'বেদি থেকে ঘুরে ঘুরে বিভিন্ন কোণে দাঁড়িয়ে সাত জোড়া প্রাচীরের ক্রমবর্ধমান অনুপাত দেখুন—প্রতিটি কোণে কাঠামোর সিলুয়েট বদলে যায়। স্তম্ভের গায়ে আরোহণ সাধারণত নিয়ন্ত্রিত; নিরাপত্তা নির্দেশনা মানুন।'
  },
  {
    title: 'উদ্যান ও বিশ্রাম',
    body: 'মূল অক্ষের বাইরের লাল ইটের পথ ধরে উদ্যানে হাঁটুন, ছায়ায় বসে কিছুক্ষণ বিশ্রাম নিন। পানীয় জল সঙ্গে রাখা আরামদায়ক; বড় খাবারের ব্যবস্থা মূলত প্রাঙ্গণের বাইরে।'
  },
  {
    title: 'প্রস্থান ও ফেরা',
    body: 'পার্কিং বা নবীনগর বাসস্ট্যান্ডের দিকে ফিরে যান। রিটার্নে ঢাকামুখী যানজট এড়াতে সন্ধ্যার আগে বের হওয়া সুবিধাজনক; চালকের সঙ্গে মিলনের স্থান আগেই ঠিক করে রাখুন।'
  }
];
---
<section class="container-shell py-18 sm:py-24">
  <div class="max-w-3xl">
    <p class="section-kicker">ভেতরে কীভাবে ঘুরবেন</p>
    <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">একটি আদর্শ দর্শন-রুটের রূপরেখা</h2>
    <p class="mt-5 text-lg leading-8 text-[#505a54]">প্রবেশ থেকে প্রস্থান পর্যন্ত একটি সাধারণ হাঁটার-ধাপ নিচে দেওয়া হলো। সম্পূর্ণ সফরে ধীরস্থিরভাবে প্রায় দেড় থেকে দুই ঘণ্টা লাগতে পারে। ধাপগুলো আনুষ্ঠানিক প্রাঙ্গণ-নির্দেশিকা নয়—ব্যবস্থাপনা বা নিরাপত্তাজনিত কারণে রুট বদলাতে পারে।</p>
  </div>
  <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {steps.map((s, i) => (
      <li class="card flex flex-col rounded-3xl p-6">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#173d30] text-base font-black text-white">
            {['১', '২', '৩', '৪', '৫', '৬'][i]}
          </span>
          <h3 class="text-lg font-black leading-snug">{s.title}</h3>
        </div>
        <p class="mt-4 flex-1 text-[15px] leading-7 text-[#505a54]">{s.body}</p>
      </li>
    ))}
  </ol>
</section>
