---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieAnalytics from '../components/CookieAnalytics.astro';
import '../styles/global.css';
import { SITE_NAME, SITE_NAME_EN } from '../data/site';
import type { Lang } from '../data/pages/types';

interface Props {
  title: string;
  description: string;
  /** 'bn' = 孟加拉语（默认，根路径），'en' = 英语（/en/ 路径） */
  lang?: Lang;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** 另一语言版本的站点内路径（如 '/en/visit/location/'），用于 hreflang 互链与语言切换 */
  altHref?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  lang = 'bn',
  image = '/images/smritisoudho-reflection.svg',
  imageAlt = lang === 'en'
    ? 'Original conceptual geometric illustration; not a photograph of the real monument'
    : 'ধারণামূলক জ্যামিতিক চিত্র; স্মৃতিসৌধের বাস্তব আলোকচিত্র নয়',
  noindex = false,
  altHref,
  jsonLd
} = Astro.props;

const htmlLang = lang === 'en' ? 'en' : 'bn-BD';
const siteName = lang === 'en' ? SITE_NAME_EN : SITE_NAME;
// 统一 canonical：目录型路径补尾斜杠，文件型路径（如 .xml/.txt）保持原样
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') || /\.[a-z0-9]+$/i.test(rawPath) ? rawPath : `${rawPath}/`;
const canonical = Astro.site ? new URL(normalizedPath, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : undefined;
const altUrl = altHref && Astro.site ? new URL(altHref, Astro.site).href : undefined;
const bnUrl = lang === 'bn' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173d30" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {bnUrl && <link rel="alternate" hreflang="bn-BD" href={bnUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {bnUrl && <link rel="alternate" hreflang="x-default" href={bnUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'bn_BD'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'bn_BD' : 'en_US'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <CookieAnalytics />
    <script is:inline>
      if ('serviceWorker' in navigator && !/^localhost$|^127\./.test(location.hostname)) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () { /* PWA 是渐进增强 */ });
        });
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="focus-ring fixed left-3 top-3 z-[100] -translate-y-24 rounded bg-white px-4 py-2 font-bold shadow focus:translate-y-0">{lang === 'en' ? 'Skip to main content' : 'মূল বিষয়ে যান'}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="main-content"><slot /></main>
    <Footer lang={lang} altHref={altHref} />
  </body>
</html>
