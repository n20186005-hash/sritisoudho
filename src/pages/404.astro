---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="পাতা পাওয়া যায়নি | জাতীয় স্মৃতিসৌধ দর্শনার্থী গাইড" description="অনুরোধ করা পাতাটি পাওয়া যায়নি।" noindex>
  <section class="container-shell grid min-h-[58vh] place-items-center py-20 text-center">
    <div class="max-w-xl">
      <p class="section-kicker">৪০৪</p>
      <h1 class="mt-3 text-5xl font-black">পাতাটি পাওয়া যায়নি</h1>
      <p class="mt-5 text-lg leading-8 text-[#505a54]">লিংকটি পুরোনো হতে পারে অথবা ঠিকানায় ভুল আছে। জাতীয় স্মৃতিসৌধের মূল দর্শনার্থী গাইডে ফিরে যান।</p>
      <a href="/" class="focus-ring mt-7 inline-block rounded-full bg-[#173d30] px-6 py-3 font-bold text-white no-underline">প্রথম পাতায় ফিরুন</a>
    </div>
  </section>
</BaseLayout>
