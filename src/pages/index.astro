---
import { anchors } from '../data/anchors';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import StoriesSection from '../components/StoriesSection.astro';
import Weather from '../components/Weather.astro';
import RouteSection from '../components/RouteSection.astro';
import SourcesSection from '../components/SourcesSection.astro';

const homeUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroUrl = Astro.site ? new URL('/images/smritisoudho-reflection.jpg', Astro.site).href : undefined;
const title = 'জাতীয় স্মৃতিসৌধ (সাভার) | National Martyrs’ Monument Visitor Guide';
const description = 'জাতীয় স্মৃতিসৌধ (National Martyrs’ Monument) সাভার, ঢাকা, বাংলাদেশে অবস্থিত। ইতিহাস, স্থাপত্য, খোলার সময়, যাতায়াত, সুবিধা, আবহাওয়া, মানচিত্র ও সাধারণ প্রশ্নসহ সম্পূর্ণ দর্শনার্থী গাইড।';

const faq = [
  {
    q: 'জাতীয় স্মৃতিসৌধ কোথায় অবস্থিত?',
    a: 'জাতীয় স্মৃতিসৌধ ঢাকা জেলার সাভারের নবীনগর এলাকায়, ঢাকা–আরিচা মহাসড়কের পাশে অবস্থিত। ঢাকা শহর থেকে সড়কপথে দূরত্ব প্রায় ৩৫ কিলোমিটার।'
  },
  {
    q: 'এখানে প্রবেশের জন্য টিকিট লাগে কি?',
    a: 'প্রকাশিত সরকারি ও স্থানীয় তথ্যসূত্রে সাধারণ দর্শনার্থীর জন্য প্রবেশ ফি উল্লেখ নেই। বিশেষ অনুষ্ঠান, নিরাপত্তা ব্যবস্থা বা ব্যবস্থাপনা পরিবর্তনের কারণে নিয়ম বদলাতে পারে, তাই গুরুত্বপূর্ণ সফরের আগে সরকারি সূত্রে যাচাই করা ভালো।'
  },
  {
    q: 'কত সময় নিয়ে ঘোরা ভালো?',
    a: 'স্থাপত্য, প্রতিফলন-পুকুর, উদ্যান ও স্মৃতিচিহ্নগুলো ধীরস্থিরভাবে দেখতে প্রায় দেড় থেকে দুই ঘণ্টা রাখলে স্বাচ্ছন্দ্য হয়। এটি একটি ভ্রমণ-পরিকল্পনার পরামর্শ, সরকারি নির্ধারিত সময় নয়।'
  },
  {
    q: 'ঢাকা থেকে গণপরিবহনে কীভাবে যাব?',
    a: 'সাভার ও নবীনগরমুখী বাসে ঢাকা–আরিচা মহাসড়ক ধরে নবীনগর নামা যায়। সাভার উপজেলা প্রশাসনের পর্যটন তথ্যে বিআরটিসি ও বিভিন্ন স্থানীয় বাসপথের উল্লেখ আছে; রুট ও স্টপ পরিবর্তনশীল হওয়ায় যাত্রার দিন অপারেটরের সঙ্গে নিশ্চিত করুন।'
  },
  {
    q: '২৬ মার্চ বা ১৬ ডিসেম্বর গেলে কী জানা দরকার?',
    a: 'জাতীয় দিবসে স্মৃতিসৌধে আনুষ্ঠানিক শ্রদ্ধা নিবেদন, অতিরিক্ত ভিড় ও নিরাপত্তা নিয়ন্ত্রণ থাকতে পারে। নীরব পরিবেশে দেখতে চাইলে অন্য দিন বেছে নেওয়া সুবিধাজনক; জাতীয় দিবসে গেলে বাড়তি সময় হাতে রাখুন।'
  },
  {
    q: 'এলাকায় শৌচাগার, খাবার, পার্কিং বা থাকার ব্যবস্থা আছে?',
    a: 'প্রাঙ্গণ মূলত খোলা জনস্থান; পার্কিং মূলত ব্যবস্থাপনার নির্ধারিত এলাকায়, আর নবীনগর বাসস্ট্যান্ড, সাভার বাজার ও মহাসড়কসংলগ্ন দোকান/বাজারে খাবার, দৈনন্দিন জিনিস, জ্বালানি ও সম্ভাব্য শৌচাগার পাওয়া যায়। প্রাঙ্গণের ভেতরে রাত্রিযাপনের ব্যবস্থা নেই। এগুলো ধরনভিত্তিক সাধারণ তথ্য—নির্দিষ্ট প্রতিষ্ঠান নয়; খোলা সময়-ফি যাওয়ার আগে যাচাই করে নিন।'
  },
  {
    q: 'কোন মৌসুমে যাওয়া ভালো?',
    a: 'নভেম্বর থেকে ফেব্রুয়ারির শীতকাল সাধারণত সবচেয়ে আরামদায়ক; মার্চ–জুনে গরম ও আর্দ্রতা বেশি, আর জুন–অক্টোবরে বর্ষা-বৃষ্টি হয়। দিনের মধ্যে সকাল ও শেষ বিকেল তুলনামূলক ভালো। হালনাগাদ তাপমাত্রা ও ৭ দিনের পূর্বাভাস এই পাতার আবহাওয়া অংশে দেখা যায়।'
  },
  {
    q: 'সাত জোড়া প্রাচীর কেন? স্মৃতিসৌধের অর্থ কী?',
    a: 'মূল কাঠামোর ক্রমশ উঁচু হতে থাকা সাত জোড়া ত্রিভুজাকার প্রাচীর বাংলাদেশের স্বাধীনতা-সংগ্রামের সাতটি অধ্যায়কে স্মরণ করায়—১৯৫২-এর ভাষা আন্দোলন, ১৯৫৪-এর যুক্তফ্রন্ট নির্বাচন, ১৯৫৬-এর শাসনতান্ত্রিক আন্দোলন, ১৯৬২-এর শিক্ষা আন্দোলন, ১৯৬৬-এর ছয় দফা, ১৯৬৯-এর গণঅভ্যুত্থান ও ১৯৭১-এর মুক্তিযুদ্ধ। উচ্চতা ক্রমে বৃদ্ধি পেয়ে প্রায় ১৫০ ফুটের শীর্ষে মিলিত হওয়া এই নকশা দেশের দীর্ঘ সংগ্রামের ধারাবাহিকতাকে প্রতিফলিত করে।'
  }
];

const attraction: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(homeUrl ? { '@id': homeUrl + '#attraction' } : {}),
  name: 'জাতীয় স্মৃতিসৌধ',
  alternateName: ['National Martyrs’ Monument', 'Jatiyo Smriti Soudho'],
  description: 'সাভারে অবস্থিত বাংলাদেশের মুক্তিযুদ্ধের শহীদদের স্মরণে নির্মিত জাতীয় স্মৃতিসৌধের স্বাধীন দর্শনার্থী তথ্য-গাইড।',
  ...(homeUrl ? { url: homeUrl } : {}),
  ...(heroUrl ? { image: [heroUrl] } : {}),
  ...(homeUrl ? { hasMap: 'https://maps.app.goo.gl/kfUxNKYsDusuGj9f6' } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ঢাকা–আরিচা মহাসড়ক, নবীনগর',
    addressLocality: 'সাভার',
    addressRegion: 'ঢাকা',
    postalCode: '1344',
    addressCountry: 'BD'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 23.911298478561065,
    longitude: 90.2522003771468
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '06:00',
    closes: '18:00'
  }],
  isAccessibleForFree: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.6',
    reviewCount: 23499,
    bestRating: '5'
  },
  sameAs: [
    'https://maps.app.goo.gl/kfUxNKYsDusuGj9f6',
    'https://beautifulbangladesh.gov.bd/loc/dhaka/93',
    'https://bn.banglapedia.org/index.php?title=জাতীয়_স্মৃতিসৌধ'
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'জাতীয় স্মৃতিসৌধ দর্শনার্থী গাইড',
  url: homeUrl,
  ...(homeUrl ? { logo: new URL('/logo.svg', homeUrl).href } : {}),
  description: 'বাংলা ভাষার স্বাধীন, অলাভজনক দর্শনার্থী তথ্য-গাইড—সাভারের জাতীয় স্মৃতিসৌধের ইতিহাস, স্থাপত্য, যাতায়াত ও ভ্রমণ-পরিকল্পনা।'
};

const webpageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: homeUrl,
  name: title,
  description,
  inLanguage: 'bn-BD',
  dateModified: '2026-09-09',
  isPartOf: {
    '@type': 'WebSite',
    name: 'জাতীয় স্মৃতিসৌধ দর্শনার্থী গাইড',
    url: homeUrl
  },
  ...(heroUrl ? { primaryImageOfPage: heroUrl } : {})
};
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={[attraction, faqSchema, orgSchema, webpageSchema]}
>
  <section class="relative min-h-[78vh] overflow-hidden bg-[#14251e] text-white">
    <img src="/images/smritisoudho-reflection.jpg" alt="জাতীয় স্মৃতিসৌধ ও সামনের প্রতিফলন-পুকুর" class="absolute inset-0 h-full w-full object-cover" width="1280" height="853" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/15"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#14251e] via-transparent to-transparent"></div>
    <div class="container-shell relative flex min-h-[78vh] items-end py-14 sm:py-20">
      <div class="max-w-4xl">
        <p class="mb-5 inline-flex rounded-full border border-white/30 bg-black/25 px-4 py-2 text-sm font-semibold backdrop-blur">সাভার · ঢাকা · বাংলাদেশের জাতীয় স্মারক</p>
        <h1 class="text-5xl font-black leading-[1.06] tracking-tight sm:text-7xl lg:text-8xl">জাতীয়<br/>স্মৃতিসৌধ
<span class="mt-4 block text-2xl font-black leading-snug tracking-normal sm:text-3xl">(সাভার, বাংলাদেশ)</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/84 sm:text-xl">জাতীয় স্মৃতিসৌধ আন্তর্জাতিকভাবে <strong class="font-bold text-white">National Martyrs’ Monument</strong> নামেও পরিচিত। ১৯৭১ সালের মুক্তিযুদ্ধে শহীদদের প্রতি জাতির শ্রদ্ধার এই স্থাপত্যে সাত জোড়া ত্রিভুজাকার প্রাচীর, প্রতিফলন-পুকুর, উদ্যান ও স্মৃতির এক নীরব অক্ষ রয়েছে।</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={'#' + anchors.visit} class="focus-ring rounded-full bg-[#b53a35] px-6 py-3 font-bold text-white no-underline hover:bg-[#9d302c]">ভ্রমণ পরিকল্পনা</a>
          <a href={'#' + anchors.transport} class="focus-ring rounded-full border border-white/35 bg-white/10 px-6 py-3 font-bold text-white no-underline backdrop-blur hover:bg-white/20">কীভাবে যাবেন</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-black/10 bg-[#eee8dc]">
    <div class="container-shell grid divide-y divide-black/10 py-7 sm:grid-cols-4 sm:divide-x sm:divide-y-0">
      <div class="px-4 py-3"><p class="text-xs font-bold text-[#8a2e2a]">অবস্থান</p><p class="mt-1 font-bold">নবীনগর, সাভার</p></div>
      <div class="px-4 py-3"><p class="text-xs font-bold text-[#8a2e2a]">ঢাকা থেকে</p><p class="mt-1 font-bold">প্রায় ৩৫ কিলোমিটার</p></div>
      <div class="px-4 py-3"><p class="text-xs font-bold text-[#8a2e2a]">মূল কাঠামোর উচ্চতা</p><p class="mt-1 font-bold">প্রায় ১৫০ ফুট</p></div>
      <div class="px-4 py-3"><p class="text-xs font-bold text-[#8a2e2a]">মানচিত্রের রেটিং</p><p class="mt-1 font-bold">৪.৬ / ৫ <span class="font-normal text-black/55">· ২৩,৪৯৯ রিভিউ · পরিবর্তনশীল</span></p></div>
    </div>
  </section>

  <section id={anchors.memory} class="memorial-lines container-shell py-18 sm:py-24">
    <div class="relative grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="section-kicker">স্মৃতি ও স্থাপত্য</p>
        <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">সাতটি ঐতিহাসিক অধ্যায়ের দিকে ওঠা এক স্মারক</h2>
        <div class="prose-bn mt-6 space-y-4 text-lg">
          <p>জাতীয় স্মৃতিসৌধ বাংলাদেশের ১৯৭১ সালের মুক্তিযুদ্ধে শহীদদের স্মরণে নির্মিত। সাভারে ঢাকা থেকে প্রায় ৩৫ কিলোমিটার উত্তর-পশ্চিমে অবস্থিত এই স্মারকের নকশা করেন স্থপতি সৈয়দ মাইনুল হোসেন।</p>
          <p>১৯৭৮ সালের জাতীয় নকশা প্রতিযোগিতায় ৫৭টি প্রস্তাবের মধ্য থেকে তাঁর নকশা নির্বাচিত হয়। মূল স্মারকটি সাত জোড়া ত্রিভুজাকার কংক্রিট প্রাচীরের ধারাবাহিকতায় নির্মিত; প্রায় ১৫০ ফুট উচ্চতার শীর্ষের দিকে এগোতে এগোতে প্রাচীরগুলো বাংলাদেশের স্বাধীনতার দীর্ঘ রাজনৈতিক সংগ্রামের সাতটি অধ্যায়কে স্মরণ করায়।</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
          <a class="rounded-full border border-black/15 px-4 py-2 hover:border-[#8a2e2a] hover:text-[#8a2e2a]" target="_blank" rel="noopener noreferrer" href="https://savar.dhaka.gov.bd/pages/tourist-spot/697f940935ce18e1c06b73cd">সাভার উপজেলা প্রশাসনের তথ্য</a>
          <a class="rounded-full border border-black/15 px-4 py-2 hover:border-[#8a2e2a] hover:text-[#8a2e2a]" target="_blank" rel="noopener noreferrer" href="https://beautifulbangladesh.gov.bd/loc/dhaka/93">বাংলাদেশ ট্যুরিজম বোর্ডের তথ্য</a>
        </div>
      </div>
      <figure class="overflow-hidden rounded-[2rem] bg-[#1b3027] shadow-2xl shadow-black/10">
        <img src="/images/smritisoudho-aerial.jpg" alt="উঁচু দৃষ্টিকোণ থেকে জাতীয় স্মৃতিসৌধ, সবুজ উদ্যান ও প্রতিফলন-পুকুর" width="1280" height="853" loading="lazy" class="aspect-[4/3] w-full object-cover" />
