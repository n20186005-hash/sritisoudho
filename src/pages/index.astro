---
import { anchors } from '../data/anchors';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import StoriesSection from '../components/StoriesSection.astro';
import Weather from '../components/Weather.astro';
import RouteSection from '../components/RouteSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import { ATTRACTION, FACTS, LAST_UPDATED, OFFICIAL_SOURCES, SITE_NAME, VISIT } from '../data/site';

const homeUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const heroUrl = Astro.site ? new URL('/images/smritisoudho-reflection.svg', Astro.site).href : undefined;

const title = 'জাতীয় স্মৃতিসৌধ সাভার: খোলার সময়, অবস্থান ও উচ্চতা';
const description = 'সাভারের জাতীয় স্মৃতিসৌধের অবস্থান, তারিখসহ মানচিত্রের সময়, প্রবেশের আগে যা নিশ্চিত করবেন, ১৫০ ফুট উচ্চতা ও ইতিহাস, যাতায়াতের প্রস্তুতি এবং আবহাওয়া পূর্বাভাস।';

const quickFacts = [
  ['খোলার সময়', VISIT.hoursDisplay, VISIT.hoursNote],
  ['প্রবেশ', VISIT.entryLabel, VISIT.entryNote],
  ['অবস্থান', `${ATTRACTION.localityShort}, ${ATTRACTION.region}`, `ঢাকা–আরিচা মহাসড়ক · প্লাস কোড ${ATTRACTION.plusCode}`],
  ['ঢাকা থেকে দূরত্ব', `প্রায় ${VISIT.distanceFromDhakaKm} কিলোমিটার`, 'ঐতিহাসিক অবস্থানবর্ণনা; যাত্রার দূরত্ব ও সময় রুটভেদে বদলায়'],
  ['মূল কাঠামোর উচ্চতা', FACTS.height, 'সাত জোড়া ত্রিভুজাকার কংক্রিট প্রাচীর'],
  ['মানচিত্রের রেটিং', `${ATTRACTION.rating.value} / ${ATTRACTION.rating.bestRating}`, `${ATTRACTION.rating.reviewCountDisplay} রিভিউ · Google Maps,২৫ অক্টোবর ২০২৬`]
];

const faq = [
  {
    "q": "সাভার স্মৃতিসৌধ কখন খোলা থাকে ও কয়টা পর্যন্ত খোলা থাকে?",
    "a": "২৫ অক্টোবর ২০২৬-এ Google Maps তালিকায় সপ্তাহের সাত দিন সকাল ১০টা থেকে বিকেল ৫টা দেখা গেছে। এটি তৃতীয় পক্ষের তালিকা, কর্তৃপক্ষের স্থায়ী ঘোষণা নয়। জাতীয় দিবস, প্রস্তুতি বা নিরাপত্তায় প্রবেশ বদলাতে পারে; যাত্রার আগে বর্তমান স্থানীয় নির্দেশনা নিশ্চিত করুন।"
  },
  {
    "q": "জাতীয় স্মৃতিসৌধ কোথায় অবস্থিত?",
    "a": "সাভার, ঢাকা জেলায় ঢাকা–আরিচা মহাসড়কের পাশে; Maps ঠিকানা Savar 1344, প্লাস কোড W763+GW। নির্দিষ্ট স্থানবিন্দু 23.9112985° উত্তর,90.2547753° পূর্ব; মানচিত্রের ক্যামেরার কেন্দ্র নয়।"
  },
  {
    "q": "জাতীয় স্মৃতিসৌধের উচ্চতা কত?",
    "a": "বাংলাপিডিয়া অনুযায়ী মূল কাঠামোর সর্বোচ্চ বিন্দু ১৫০ ফুট বা ৪৫.৭২ মিটার। কমপ্লেক্স ৩৪ হেক্টর, তার বাইরে আরও ১০ হেক্টর সবুজ অঞ্চল—এই দুই ক্ষেত্রের আয়তন এক নয়।"
  },
  {
    "q": "জাতীয় স্মৃতিসৌধের অপর নাম কি?",
    "a": "National Martyrs’ Memorial বা Monument এবং Jatiyo Smriti Soudho একই সাভারের স্মারকের নাম; আলাদা গন্তব্য নয়।"
  },
  {
    "q": "ঢাকা থেকে জাতীয় স্মৃতিসৌধ কত দূর?",
    "a": "পর্যটন বোর্ড ও বাংলাপিডিয়া ঢাকার প্রায় ৩৫ কিলোমিটার উত্তর-পশ্চিমে সাভারের অবস্থান বর্ণনা করে। শুরুর স্থান, নির্বাচিত সড়ক ও যানজটে আসল দূরত্ব ও সময় বদলায়; এটি নিশ্চিত যাত্রাসময় নয়।"
  },
  {
    "q": "জাতীয় স্মৃতিসৌধ কে নকশা করেছেন ও কবে উদ্বোধন হয়?",
    "a": "স্থপতি সৈয়দ মাইনুল হোসেনের নকশা ১৯৭৮ সালের ৫৭টি প্রস্তাবের প্রতিযোগিতা থেকে নির্বাচিত। পর্যটন বোর্ড ১৬ ডিসেম্বর ১৯৮২ উদ্বোধনের কথা বলে; বাংলাপিডিয়া নির্মাণ তত্ত্বাবধানে গণপূর্ত বিভাগের কথা বলে।"
  },
  {
    "q": "এখানে প্রবেশের জন্য টিকিট লাগে কি?",
    "a": "বর্তমান সাধারণ প্রবেশমূল্য বা টিকিটের সম্পূর্ণ নিয়ম নিশ্চিত করা যায়নি। কোনো পৃষ্ঠায় ফি না থাকাকে বিনামূল্যে প্রবেশের প্রমাণ ভাববেন না; ব্যবস্থাপনার কাছে বর্তমান নিয়ম যাচাই করুন।"
  },
  {
    "q": "কত সময় নিয়ে ঘোরা ভালো?",
    "a": "দেড়–দুই ঘণ্টা একটি নমনীয় পরিকল্পনার শুরু হতে পারে। বর্তমান খোলা অংশ, আপনার হাঁটার গতি, বিশ্রাম ও নিরাপত্তা নিয়ন্ত্রণ অনুযায়ী ছোট করুন; সব অংশ দেখা বা সম্পূর্ণ সফর নিশ্চিত নয়।"
  },
  {
    "q": "ঢাকা থেকে গণপরিবহনে কীভাবে যাব?",
    "a": "সাভার–নবীনগর এলাকার মানচিত্র ধরে বর্তমান বাসের গন্তব্য, নামার স্টপ, শেষ হাঁটার অংশ ও ফেরার ব্যবস্থা অপারেটরের কাছে জেনে নিন। এই গাইড কোনো নির্দিষ্ট চলতি বাস বা সময়সূচি নিশ্চিত করে না।"
  },
  {
    "q": "২৬ মার্চ বা ১৬ ডিসেম্বর গেলে কী জানা দরকার?",
    "a": "আনুষ্ঠানিক কর্মসূচি বা প্রস্তুতিতে প্রবেশ, যান চলাচল ও নিরাপত্তা নিয়ন্ত্রণ বদলাতে পারে। সাধারণ তালিকার সময়ে নির্ভর না করে সংশ্লিষ্ট দিনের সরকারি ঘোষণা দেখুন এবং বিকল্প পরিকল্পনা রাখুন।"
  },
  {
    "q": "এলাকায় শৌচাগার, খাবার, পার্কিং বা থাকার ব্যবস্থা আছে?",
    "a": "প্রয়োজনীয় শৌচাগার, পানীয় জল, উপযুক্ত প্রবেশপথ ও অনুমোদিত পার্কিং আলাদা করে নিশ্চিত করুন। নির্মাণ-ইতিহাসে কোনো সুবিধা থাকলেই সেটি আজ চালু বা সবার ব্যবহারযোগ্য প্রমাণ হয় না। এই তালিকা সেবার নিশ্চিত তালিকা নয়।"
  },
  {
    "q": "কোন মৌসুমে যাওয়া ভালো?",
    "a": "নির্দিষ্ট মাসকে নিশ্চিত আরামদায়ক না ধরে আসল তাপ, UV, বৃষ্টি ও বাতাস দেখুন। শুধু নিশ্চিত খোলা সময়ের মধ্যে রুট ও বিশ্রাম বেছে নিন; পূর্বাভাস প্রবেশ বা পথের অবস্থা নিশ্চিত করে না।"
  },
  {
    "q": "সাত জোড়া প্রাচীর কেন? স্মৃতিসৌধের অর্থ কী?",
    "a": "পর্যটন বোর্ড সাত জোড়া প্রাচীরকে ১৯৫২,১৯৫৪,১৯৫৬,১৯৬২,১৯৬৬,১৯৬৯ ও১৯৭১-এর সংগ্রামের অধ্যায়ের সঙ্গে যুক্ত করে। বাংলাপিডিয়া ভাঁজ করা বিভিন্ন অনুপাতের সাতটি ত্রিভুজাকার প্রাচীরের বিন্যাস ব্যাখ্যা করে।"
  }
];

const attraction: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  ...(homeUrl ? { '@id': homeUrl + '#attraction' } : {}),
  name: ATTRACTION.nameBn,
  alternateName: [...ATTRACTION.alternateNames],
  description: 'সাভারে অবস্থিত বাংলাদেশের মুক্তিযুদ্ধের শহীদদের স্মরণে নির্মিত জাতীয় স্মৃতিসৌধের স্বাধীন দর্শনার্থী তথ্য-গাইড।',
  amenityFeature: [{ '@type': 'LocationFeatureSpecification', name: 'মূল কাঠামোর উচ্চতা', value: FACTS.height }],
  ...(homeUrl ? { url: homeUrl } : {}),
  ...(homeUrl ? { hasMap: ATTRACTION.googleMapsUrl } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: ATTRACTION.streetAddress,
    addressLocality: ATTRACTION.locality,
    addressRegion: ATTRACTION.region,
    postalCode: ATTRACTION.postalCode,
    addressCountry: ATTRACTION.country
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ATTRACTION.latitude,
    longitude: ATTRACTION.longitude
  },
  sameAs: [
    ATTRACTION.googleMapsUrl,
    OFFICIAL_SOURCES[1].url,
    OFFICIAL_SOURCES[2].url
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: homeUrl,
  ...(homeUrl ? { logo: new URL('/logo.svg', homeUrl).href } : {}),
  description: 'বাংলা ভাষার স্বাধীন, অলাভজনক দর্শনার্থী তথ্য-গাইড—সাভারের জাতীয় স্মৃতিসৌধের ইতিহাস, স্থাপত্য, যাতায়াত ও ভ্রমণ-পরিকল্পনা।'
};

const webpageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: homeUrl,
  name: title,
  description,
  inLanguage: 'bn-BD',
  dateModified: LAST_UPDATED.iso,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: homeUrl
  },
  ...(heroUrl ? { primaryImageOfPage: { '@type': 'ImageObject', url: heroUrl, caption: 'মৌলিক ধারণামূলক চিত্র; বাস্তব আলোকচিত্র নয়' } } : {})
};
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={[attraction, faqSchema, orgSchema, webpageSchema]}
>
  <section class="relative min-h-[78vh] overflow-hidden bg-[#14251e] text-white">
    <img src="/images/smritisoudho-reflection.svg" alt="মৌলিক ধারণামূলক চিত্র — স্মারক, পথ ও জলাশয়ের জ্যামিতিক ইঙ্গিত; বাস্তব আলোকচিত্র নয়" class="absolute inset-0 h-full w-full object-cover" width="1280" height="853" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/15"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#14251e] via-transparent to-transparent"></div>
    <div class="container-shell relative flex min-h-[78vh] items-end py-14 sm:py-20">
      <div class="max-w-4xl">
        <p class="mb-5 inline-flex rounded-full border border-white/30 bg-black/25 px-4 py-2 text-sm font-semibold backdrop-blur">সাভার · ঢাকা · বাংলাদেশের জাতীয় স্মারক</p>
        <h1 class="text-5xl font-black leading-[1.06] tracking-tight sm:text-7xl lg:text-8xl">জাতীয়<br/>স্মৃতিসৌধ
<span class="mt-4 block text-2xl font-black leading-snug tracking-normal sm:text-3xl">(সাভার, বাংলাদেশ)</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/84 sm:text-xl">জাতীয় স্মৃতিসৌধ আন্তর্জাতিকভাবে <strong class="font-bold text-white">National Martyrs’ Monument</strong> নামেও পরিচিত। ১৯৭১ সালের মুক্তিযুদ্ধে শহীদদের প্রতি জাতির শ্রদ্ধার এই স্থাপত্যে সাত জোড়া ত্রিভুজাকার প্রাচীর, প্রতিফলন-পুকুর, উদ্যান ও স্মৃতির এক নীরব অক্ষ রয়েছে।</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={'#' + anchors.visit} class="focus-ring rounded-full bg-[#b53a35] px-6 py-3 font-bold text-white no-underline hover:bg-[#9d302c]">ভ্রমণ পরিকল্পনা</a>
          <a href={'#' + anchors.transport} class="focus-ring rounded-full border border-white/35 bg-white/10 px-6 py-3 font-bold text-white no-underline backdrop-blur hover:bg-white/20">কীভাবে যাবেন</a>
        </div>
      </div>
    </div>
  </section>

  <p class="container-shell mt-3 text-sm text-[#505a54]">পটভূমিটি মৌলিক ধারণামূলক চিত্র; স্মৃতিসৌধের বাস্তব আলোকচিত্র নয়।</p>

  <section class="border-b border-black/10 bg-[#eee8dc]" aria-label="এক নজরে মূল তথ্য">
    <div class="container-shell grid gap-3 py-8 sm:grid-cols-2 lg:grid-cols-3">
      {quickFacts.map(([label, value, note]) => (
        <div class="rounded-2xl border border-black/10 bg-white/70 px-5 py-4">
          <p class="text-xs font-bold tracking-wide text-[#8a2e2a]">{label}</p>
          <p class="mt-1 text-lg font-black leading-7">{value}</p>
          <p class="mt-1 text-xs leading-5 text-black/55">{note}</p>
        </div>
      ))}
    </div>
  </section>

  <section id={anchors.memory} class="memorial-lines container-shell py-18 sm:py-24">
    <div class="relative grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="section-kicker">স্মৃতি ও স্থাপত্য</p>
        <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">সাতটি ঐতিহাসিক অধ্যায়ের দিকে ওঠা এক স্মারক</h2>
        <div class="prose-bn mt-6 space-y-4 text-lg">
